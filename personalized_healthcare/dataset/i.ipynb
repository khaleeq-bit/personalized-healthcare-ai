    "import requests\n",
    "\n",
    "response = requests.post(\n",
    "    \"http://127.0.0.1:5000/predict\",\n",
    "    json={\n",
    "        \"age\": 25,\n",
    "        \"symptoms\": [\"fever\", \"cough\", \"headache\"]\n",
    "    }\n",
    ")\n",
    "\n",
    "print(\"Status:\", response.status_code)\n",
    "print(\"Response:\", response.text)"
   ]
  }
